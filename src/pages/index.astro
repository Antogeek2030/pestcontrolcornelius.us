---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';

const featuredServices = services.slice(0, 6);
---

<BaseLayout
  title="Pest Control in Cornelius, NC | Professional & Friendly Service"
  description="Local pest control for homes and businesses in Cornelius, NC and nearby communities. Ants, termites, rodents, mosquitoes, and more. Request your free quote today."
  canonical="/"
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-primary-700 via-primary-600 to-primary-800 text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('/hero-pattern.svg')] opacity-10"></div>
    <div class="container-narrow relative section-padding">
      <div class="max-w-2xl">
        <p class="text-primary-100 font-medium mb-3">Serving Cornelius, NC & Lake Norman</p>
        <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">
          Professional Pest Control You Can Trust
        </h1>
        <p class="text-lg text-primary-50 mb-8 leading-relaxed">
          From ants and termites to rodents and mosquitoes, we help protect your home or business with thorough inspections, targeted treatments, and clear communication. Friendly service. Local knowledge.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="btn-primary bg-white text-primary-700 hover:bg-primary-50">
            Request a Free Quote
          </a>
          <a href="/services" class="btn-secondary border-white text-white hover:bg-white/10">
            View Our Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="bg-gray-50 border-b border-gray-100">
    <div class="container-narrow py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-primary-700">Local</p>
          <p class="text-sm text-gray-600 mt-1">Cornelius-based team</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-primary-700">Thorough</p>
          <p class="text-sm text-gray-600 mt-1">Inspections first</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-primary-700">Clear</p>
          <p class="text-sm text-gray-600 mt-1">No jargon, no pressure</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-primary-700">Flexible</p>
          <p class="text-sm text-gray-600 mt-1">One-time or ongoing</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services overview -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Pest Control Services</h2>
        <p class="text-gray-600 leading-relaxed">
          We handle the pests most common to homes and businesses in the Lake Norman area. Every service starts with an inspection so we treat what is actually present—not a generic checklist.
        </p>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredServices.map(service => (
          <a 
            href={`/services/${service.slug}`} 
            class="group block rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition hover:border-primary-300 hover:shadow-md"
          >
            <h3 class="text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition mb-2">
              {service.name}
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">
              {service.shortDesc}
            </p>
            <span class="text-sm font-medium text-primary-600 group-hover:text-primary-700">
              Learn more →
            </span>
          </a>
        ))}
      </div>
      
      <div class="text-center mt-10">
        <a href="/services" class="btn-secondary">
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="section-padding bg-gray-50">
    <div class="container-narrow">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Why Choose pestcontrolcorneliusnc?</h2>
          <ul class="space-y-5">
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-700 font-semibold text-sm">1</span>
              <div>
                <h3 class="font-semibold text-gray-900">Local focus</h3>
                <p class="text-gray-600 text-sm mt-1">We know the pests, the seasons, and the housing stock common to Cornelius and the surrounding Lake Norman communities.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-700 font-semibold text-sm">2</span>
              <div>
                <h3 class="font-semibold text-gray-900">Honest recommendations</h3>
                <p class="text-gray-600 text-sm mt-1">We explain what we find and why a particular approach makes sense. No upselling for treatments you do not need.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-700 font-semibold text-sm">3</span>
              <div>
                <h3 class="font-semibold text-gray-900">Flexible options</h3>
                <p class="text-gray-600 text-sm mt-1">One-time treatments, quarterly plans, or monthly service—choose what fits your property and budget.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-700 font-semibold text-sm">4</span>
              <div>
                <h3 class="font-semibold text-gray-900">Respect for your time and space</h3>
                <p class="text-gray-600 text-sm mt-1">We arrive as scheduled, work carefully, and leave your property as clean as we found it.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="rounded-2xl bg-primary-700 p-8 text-white">
          <h3 class="text-xl font-semibold mb-4">Ready to get started?</h3>
          <p class="text-primary-100 mb-6 leading-relaxed">
            Tell us about the pests you are seeing and we will recommend the most practical next step. No obligation, no pressure.
          </p>
          <a href="/contact" class="btn-primary bg-white text-primary-700 hover:bg-primary-50 w-full sm:w-auto justify-center">
            Request Your Free Quote
          </a>
          <p class="mt-6 text-sm text-primary-200">
            Serving Cornelius, Huntersville, Davidson, Mooresville, and nearby areas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews placeholder (honest) -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">What Customers Value</h2>
        <p class="text-gray-600">
          We earn trust through consistent, careful work—not manufactured reviews. Here is what people typically appreciate about working with a focused local team.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="rounded-xl border border-gray-200 p-6">
          <p class="text-gray-700 leading-relaxed mb-4">“Clear explanation of what was found and what the treatment would actually do. No scare tactics.”</p>
          <p class="text-sm font-medium text-gray-900">— Homeowner, Cornelius</p>
        </div>
        <div class="rounded-xl border border-gray-200 p-6">
          <p class="text-gray-700 leading-relaxed mb-4">“Showed up on time, treated the problem areas thoroughly, and followed up to make sure things were improving.”</p>
          <p class="text-sm font-medium text-gray-900">— Homeowner, Huntersville</p>
        </div>
        <div class="rounded-xl border border-gray-200 p-6">
          <p class="text-gray-700 leading-relaxed mb-4">“Helpful with both the treatment and the simple prevention steps we could take ourselves between visits.”</p>
          <p class="text-sm font-medium text-gray-900">— Small business, Davidson</p>
        </div>
      </div>
      <p class="text-center text-sm text-gray-500 mt-8">
        These examples reflect common feedback themes. We do not publish fabricated star ratings or statistics.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section-padding bg-primary-700 text-white">
    <div class="container-narrow text-center">
      <h2 class="text-3xl font-bold mb-4">Protect Your Home or Business</h2>
      <p class="text-primary-100 max-w-xl mx-auto mb-8">
        Whether you need a one-time treatment or an ongoing plan, we are ready to help. Reach out today for a free, no-pressure quote.
      </p>
      <a href="/contact" class="btn-primary bg-white text-primary-700 hover:bg-primary-50">
        Get Your Free Quote
      </a>
    </div>
  </section>
</BaseLayout>
