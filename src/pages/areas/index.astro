---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { areas } from '../../data/areas';
---

<BaseLayout
  title="Service Areas | Pest Control in Cornelius, NC & Nearby"
  description="pestcontrolcorneliusnc serves Cornelius, Huntersville, Davidson, Mooresville, Denver NC, and northern Charlotte. Local pest control with reliable response times."
  canonical="/areas"
>
  <section class="bg-primary-700 text-white">
    <div class="container-narrow section-padding">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Service Areas</h1>
      <p class="text-primary-100 max-w-2xl leading-relaxed">
        We proudly serve Cornelius and the surrounding Lake Norman communities. Local knowledge means faster response and treatments suited to the conditions in this region.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-narrow">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {areas.map(area => (
          <a 
            href={`/areas/${area.slug}`}
            class="group block rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition hover:border-primary-300 hover:shadow-md"
          >
            <h2 class="text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition mb-2">
              {area.name}
            </h2>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">
              {area.shortDesc}
            </p>
            <span class="text-sm font-medium text-primary-600">
              Learn more →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-narrow text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Don't see your neighborhood?</h2>
      <p class="text-gray-600 max-w-xl mx-auto mb-6">
        We may still be able to help. Contact us with your location and we will let you know about availability.
      </p>
      <a href="/contact" class="btn-primary">Contact Us</a>
    </div>
  </section>
</BaseLayout>
