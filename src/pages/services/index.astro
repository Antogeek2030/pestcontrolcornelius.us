---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
---

<BaseLayout
  title="Pest Control Services in Cornelius, NC"
  description="Browse our full range of residential and commercial pest control services. Ants, termites, rodents, bed bugs, mosquitoes, and more. Serving Cornelius and nearby communities."
  canonical="/services"
>
  <section class="bg-primary-700 text-white">
    <div class="container-narrow section-padding">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Our Pest Control Services</h1>
      <p class="text-primary-100 max-w-2xl leading-relaxed">
        Every property is different. We start with an inspection, explain what we find, and recommend practical solutions—whether you need a one-time treatment or ongoing protection.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-narrow">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(service => (
          <a 
            href={`/services/${service.slug}`}
            class="group flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition hover:border-primary-300 hover:shadow-md"
          >
            <h2 class="text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition mb-2">
              {service.name}
            </h2>
            <p class="text-sm text-gray-600 leading-relaxed flex-1 mb-4">
              {service.shortDesc}
            </p>
            <span class="text-sm font-medium text-primary-600">
              Details & process →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-narrow text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Not sure which service you need?</h2>
      <p class="text-gray-600 max-w-xl mx-auto mb-6">
        Describe what you are seeing and we will point you in the right direction. No pressure, just practical advice.
      </p>
      <a href="/contact" class="btn-primary">Request a Free Quote</a>
    </div>
  </section>
</BaseLayout>
