---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | pestcontrolcorneliusnc"
  description="The page you requested could not be found."
  noindex={true}
>
  <section class="section-padding">
    <div class="container-narrow text-center max-w-lg mx-auto">
      <p class="text-6xl font-bold text-primary-600 mb-4">404</p>
      <h1 class="text-2xl font-bold text-gray-900 mb-4">Page not found</h1>
      <p class="text-gray-600 mb-8">
        The page you are looking for does not exist or may have been moved. Try one of the links below or head back to the homepage.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="/services" class="btn-secondary">View Services</a>
        <a href="/contact" class="btn-secondary">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
